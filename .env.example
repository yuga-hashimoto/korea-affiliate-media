# Copy to .env.local. NEVER commit real credentials.
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=総額比較
# 検索エンジンにindexさせるのは本番のみ（Preview/Stagingはfalse）
SITE_INDEXING_ENABLED=false
ADMIN_ACTOR=
NEXT_PUBLIC_CONTACT_EMAIL=

NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-C4CJ11GEDH
# GA4 Data API（読み取り専用）。サービスアカウントJSONは var/ 等のGit管理外に置く
GA4_PROPERTY_ID=563135187
GOOGLE_SEARCH_CONSOLE_PROPERTY=https://sougakuhikaku.com/
GOOGLE_APPLICATION_CREDENTIALS=

DATABASE_URL=
DATA_DIR=
# クリック計測の匿名化ソルト（必ずランダムな長い文字列）
CLICK_HASH_SALT=

# --- AI articles ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ARTICLE_DRAFTS_PER_RUN=2

# --- X / SNS ---
SOCIAL_DRAFTS_PER_DAY=2
SOCIAL_WEBHOOK_URL=
SOCIAL_WEBHOOK_SECRET=
# Paid Partnership開示をAPIで保証できると確認できるまでfalse
SOCIAL_PAID_PARTNERSHIP_SUPPORTED=false

# --- Kill switches (default: OFF) ---
AFFILIATE_LINKS_ENABLED=false
# 承認済み成果リンク（JSON, ビルド時のみ。Gitにコミットしない）
# 例: {"prog-klook":"https://...","prog-tripcom":"https://..."}
AFFILIATE_LINKS_JSON=
SOCIAL_PUBLISH_ENABLED=false
CONTENT_AUTO_PUBLISH_ENABLED=false
CONTENT_REVIEW_REQUIRED=true
JOB_DAILY_BUDGET_JPY=0

# Add credentials for each approved affiliate using its official documentation.
# Do not guess or expose account-specific tracking IDs or tokens.
